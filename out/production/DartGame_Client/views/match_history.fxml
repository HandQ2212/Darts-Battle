<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="rootPane"
            fx:controller="controllers.MatchHistoryController"
            prefWidth="900" prefHeight="600"
            stylesheets="@match_history.css">

    <VBox alignment="CENTER" spacing="20"
          AnchorPane.topAnchor="50"
          AnchorPane.leftAnchor="50"
          AnchorPane.rightAnchor="50">

        <Label text="Match History"
               style="
                   -fx-font-size: 28px;
                   -fx-text-fill: black;
                   -fx-font-weight: bold;
               "/>

        <TableView fx:id="historyTable"
                   prefHeight="400"
                   style="-fx-background-color: rgba(255,255,255,0.6);
                          -fx-background-radius: 12;
                          -fx-border-color: rgba(0,0,0,0.2);
                          -fx-border-radius: 12;"
        >
            <columns>
                <TableColumn fx:id="usernameCol" text="You"/>
                <TableColumn fx:id="opponentCol" text="Opponent"/>
                <TableColumn fx:id="resultCol" text="Result"/>
                <TableColumn fx:id="timeCol" text="Time"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER" spacing="25">

            <Button text="Reload"
                    onAction="#onReloadClick"
                    style="
                        -fx-background-color: rgba(255,255,255,0.7);
                        -fx-text-fill: black;
                        -fx-font-size: 14px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 10;
                        -fx-padding: 8 20;
                    "/>

            <Button text="Back"
                    onAction="#handleBack"
                    style="
                        -fx-background-color: rgba(244, 67, 54, 0.8);
                        -fx-text-fill: white;
                        -fx-font-size: 14px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 10;
                        -fx-padding: 8 25;
                    "/>
        </HBox>

        <!-- Loading box -->
        <HBox fx:id="loadingBox"
              alignment="CENTER"
              spacing="10"
              visible="false"
              managed="false">
            <Label text="Loading..."
                   style="-fx-font-size: 16px; -fx-text-fill: black;"/>
        </HBox>

    </VBox>

</AnchorPane>
