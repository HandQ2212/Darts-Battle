<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import ui.MenuArtwork?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:id="rootPane" fx:controller="controllers.HomeController" prefWidth="1100" prefHeight="740" stylesheets="@theme.css" styleClass="app-root, menu-screen">
 <VBox spacing="18" styleClass="page" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
  <HBox alignment="CENTER_LEFT" spacing="12"><ImageView fitWidth="26" fitHeight="26"><image><Image url="@../assets/icons/crosshair.png"/></image></ImageView><Label text="DARTS BATTLE" styleClass="brand"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="usernameLabel" text="Người chơi" styleClass="badge"/><Button fx:id="btnToggleMusic" text="Nhạc: bật" onAction="#handleToggleMusic" styleClass="ghost"/><Button text="Đăng xuất" onAction="#handleLogout" styleClass="ghost"/></HBox>
  <Region styleClass="divider"/>
  <HBox spacing="24" VBox.vgrow="ALWAYS">
   <VBox spacing="12" prefWidth="390" minWidth="350">
    <Label text="PHI TIÊU VUI NHỘN" styleClass="eyebrow"/>
    <VBox spacing="-32"><Label text="DARTS" styleClass="game-logo"/><Label text="BATTLE" styleClass="game-logo, game-logo-accent"/></VBox>
    <Label text="Cùng thử tài ngắm bắn nào!" styleClass="section-title"/>
    <Region prefHeight="6"/>
    <Button text="▶   CHƠI VỚI BẠN BÈ" onAction="#handleStartGame" styleClass="menu-play, menu-online" maxWidth="Infinity"/>
    <Button text="▶   CHƠI VỚI BOT" onAction="#handleClickStartGameWithBot" styleClass="menu-play, menu-bot" maxWidth="Infinity"/>
    <Label text="Mời bạn bè cùng chơi hoặc luyện tay với bot." styleClass="muted" wrapText="true" minHeight="-Infinity"/>
    <Region VBox.vgrow="ALWAYS"/>
    <HBox spacing="8"><Button text="Bảng xếp hạng" onAction="#handleRanking" HBox.hgrow="ALWAYS" maxWidth="Infinity"/><Button text="Lịch sử đấu" onAction="#handleClickMatchHistory" HBox.hgrow="ALWAYS" maxWidth="Infinity"/></HBox>
   </VBox>
   <StackPane HBox.hgrow="ALWAYS" styleClass="menu-art"><MenuArtwork/><Label text="SẴN SÀNG CHƠI CHƯA?" styleClass="badge" StackPane.alignment="TOP_CENTER" translateY="18"/></StackPane>
  </HBox>
  <HBox alignment="CENTER_LEFT" spacing="20" styleClass="menu-foot"><Label text="301" styleClass="brand"/><Label text="ĐIỂM XUẤT PHÁT" styleClass="eyebrow"/><Region HBox.hgrow="ALWAYS"/><Label text="3 PHI TIÊU / LƯỢT" styleClass="muted"/><Label text="VỀ ĐÚNG 0 ĐỂ THẮNG" styleClass="eyebrow"/><Hyperlink text="Nguồn ảnh" onAction="#handleCredits"/></HBox>
 </VBox>
</AnchorPane>