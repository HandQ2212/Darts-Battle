<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import ui.ArenaBackdrop?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="rootPane" fx:controller="controllers.StartGameController" prefWidth="1160" prefHeight="800" stylesheets="@theme.css" styleClass="app-root, game-page">
 <top><HBox alignment="CENTER_LEFT" spacing="12" styleClass="game-header">
  <Button text="← Rời trận" onAction="#handleBack" styleClass="ghost"/>
  <Label text="DARTS BATTLE" styleClass="brand"/><Label text="301" styleClass="badge"/>
  <Region HBox.hgrow="ALWAYS"/>
  <Button fx:id="soundButton" text="Nhạc: bật" onAction="#toggleSound" styleClass="ghost"/>
  <Button fx:id="effectSoundButton" text="Hiệu ứng: bật" onAction="#toggleEffectSound" styleClass="ghost"/>
 </HBox></top>
 <center><HBox fx:id="gameMain" styleClass="game-main" alignment="TOP_CENTER">
  <VBox fx:id="leftColumn" spacing="9" minWidth="220" prefWidth="240" maxWidth="280">
   <Label fx:id="myTurnTag" text="Lượt của bạn" styleClass="turn-indicator"/>
   <VBox fx:id="myScoreSlot"/>
   <Button fx:id="myHistoryButton" text="Hiện lịch sử các lượt" onAction="#showHistory" maxWidth="Infinity" styleClass="history-button"/>
   <StackPane fx:id="localVideoFrame" styleClass="video-frame" minHeight="0">
    <ImageView fx:id="localVideoView" preserveRatio="true" smooth="true"/>
    <Label fx:id="localVideoPlaceholder" text="Camera của bạn đang tắt" styleClass="video-placeholder" wrapText="true" mouseTransparent="true"/>
   </StackPane>
   <Label fx:id="mediaStatusLabel" text="Đang kết nối mic/video…" styleClass="media-status" wrapText="true"/>
   <HBox fx:id="mediaControls" spacing="9" alignment="CENTER_LEFT">
    <Button fx:id="cameraButton" onAction="#toggleCamera" styleClass="device-button"/>
    <Button fx:id="microphoneButton" onAction="#toggleMicrophone" styleClass="device-button"/>
    <Button fx:id="deviceSettingsButton" onAction="#showDeviceSettings" styleClass="device-button"/>
   </HBox>
  </VBox>
  <VBox fx:id="centerColumn" spacing="9" minWidth="450" HBox.hgrow="ALWAYS">
   <StackPane styleClass="arena" VBox.vgrow="ALWAYS" minHeight="412">
    <ArenaBackdrop/>
    <StackPane fx:id="boardContainer" minWidth="450" maxWidth="450" minHeight="400" maxHeight="400" prefWidth="450" prefHeight="400">
     <Pane fx:id="gamePane" minWidth="450" maxWidth="450" minHeight="400" maxHeight="400" prefWidth="450" prefHeight="400" styleClass="board-surface"/>
     <VBox fx:id="botTurnOverlay" alignment="CENTER" spacing="12" visible="false" mouseTransparent="true" styleClass="bot-overlay"><ProgressIndicator prefWidth="36" prefHeight="36" maxWidth="36" maxHeight="36"/><Label text="Bot đang ngắm..."/></VBox>
    </StackPane>
   </StackPane>
   <HBox alignment="CENTER" styleClass="compact-guidance"><Label fx:id="aimStatusLabel" text="Chờ lượt" styleClass="instruction" wrapText="true"/></HBox>
  </VBox>
  <VBox fx:id="rightColumn" spacing="9" minWidth="220" prefWidth="240" maxWidth="280">
   <Label fx:id="otherTurnTag" text="Lượt đối thủ" styleClass="turn-indicator"/>
   <VBox fx:id="otherScoreSlot"/>
   <Button fx:id="otherHistoryButton" text="Hiện lịch sử các lượt" onAction="#showHistory" maxWidth="Infinity" styleClass="history-button"/>
   <StackPane fx:id="remoteVideoFrame" styleClass="video-frame" minHeight="0">
    <ImageView fx:id="remoteVideoView" preserveRatio="true" smooth="true"/>
    <Label fx:id="remoteVideoPlaceholder" text="Camera đối thủ đang tắt" styleClass="video-placeholder" wrapText="true" mouseTransparent="true"/>
   </StackPane>
   <BorderPane fx:id="chatPanel" styleClass="chat-panel" VBox.vgrow="ALWAYS" minHeight="140">
    <top><Label text="TRÒ CHUYỆN" styleClass="eyebrow"/></top>
    <center><ListView fx:id="chatList" styleClass="chat-list"><placeholder><Label text="Gửi một lời chào đối thủ." styleClass="muted, small" wrapText="true"/></placeholder></ListView></center>
    <bottom><HBox fx:id="chatComposer" spacing="6" alignment="CENTER"><TextField fx:id="chatInput" promptText="Nhập tin nhắn..." minWidth="0" HBox.hgrow="ALWAYS"/><Button text="Gửi" onAction="#handleSend" styleClass="primary, chat-send"/></HBox></bottom>
   </BorderPane>
  </VBox>
 </HBox></center>
</BorderPane>
