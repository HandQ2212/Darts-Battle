<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.MatchHistoryController" prefWidth="1100" prefHeight="740" stylesheets="@theme.css" styleClass="app-root">
 <VBox spacing="18" styleClass="page" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
  <HBox alignment="CENTER_LEFT"><Button text="← Quay lại" onAction="#handleBack" styleClass="ghost"/><Region HBox.hgrow="ALWAYS"/><Label text="DARTS / BATTLE" styleClass="brand"/></HBox><Region styleClass="divider"/>
  <HBox alignment="CENTER_LEFT"><VBox spacing="7" HBox.hgrow="ALWAYS"><Label text="HÀNH TRÌNH THI ĐẤU" styleClass="eyebrow"/><Label fx:id="headingLabel" text="Lịch sử thi đấu." styleClass="title"/><Label text="Các trận đã hoàn thành, mới nhất trước." styleClass="muted"/></VBox><Button text="Làm mới" onAction="#onReloadClick"/></HBox>
  <TableView fx:id="historyTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="usernameCol" text="NGƯỜI CHƠI" prefWidth="180"/><TableColumn fx:id="opponentCol" text="ĐỐI THỦ" prefWidth="180"/><TableColumn fx:id="resultCol" text="KẾT QUẢ" prefWidth="120"/><TableColumn fx:id="timeCol" text="THỜI GIAN" prefWidth="200"/><TableColumn fx:id="detailsCol" text="CHI TIẾT" prefWidth="140"/></columns><placeholder><Label text="Chưa có trận đã hoàn thành." styleClass="muted"/></placeholder></TableView>
  <HBox fx:id="loadingBox" visible="false" managed="false" alignment="CENTER" spacing="10"><ProgressIndicator prefWidth="20" prefHeight="20"/><Label text="Đang tải lịch sử..." styleClass="muted"/></HBox>
  <HBox alignment="CENTER" spacing="14"><Button fx:id="previousButton" text="← Trang trước" onAction="#previous"/><Label fx:id="pageLabel" text="Trang 1"/><Button fx:id="nextButton" text="Trang tiếp →" onAction="#next"/></HBox>
 </VBox>
</AnchorPane>
