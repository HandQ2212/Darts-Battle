<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:id="rootPane" fx:controller="controllers.MatchHistoryController" prefWidth="1100" prefHeight="740" stylesheets="@theme.css" styleClass="app-root">
 <VBox spacing="18" styleClass="page" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
  <HBox alignment="CENTER_LEFT"><Button text="← Sảnh chính" onAction="#handleBack" styleClass="ghost"/><Region HBox.hgrow="ALWAYS"/><Label text="DARTS / BATTLE" styleClass="brand" wrapText="true"/></HBox><Region styleClass="divider"/>
  <HBox alignment="CENTER_LEFT"><VBox spacing="7" HBox.hgrow="ALWAYS"><Label text="HÀNH TRÌNH CỦA BẠN" styleClass="eyebrow" wrapText="true"/><Label text="Lịch sử thi đấu." styleClass="title" wrapText="true"/><Label text="Mỗi trận đấu là một bước tiến." styleClass="muted" wrapText="true"/></VBox><Button text="Làm mới" onAction="#onReloadClick"/></HBox>
  <TableView fx:id="historyTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="usernameCol" text="BẠN" prefWidth="220"/><TableColumn fx:id="opponentCol" text="ĐỐI THỦ" prefWidth="220"/><TableColumn fx:id="resultCol" text="KẾT QUẢ" prefWidth="140"/><TableColumn fx:id="timeCol" text="THỜI GIAN" prefWidth="280"/></columns><placeholder><VBox alignment="CENTER" spacing="10"><Label text="Trận đầu tiên đang chờ bạn" styleClass="section-title" wrapText="true"/><Label text="Các trận đã hoàn thành sẽ được hiển thị tại đây." styleClass="muted" wrapText="true"/></VBox></placeholder></TableView>
  <HBox fx:id="loadingBox" visible="false" managed="false" alignment="CENTER" spacing="10"><ProgressIndicator prefWidth="20" prefHeight="20"/><Label text="Đang tải lịch sử..." styleClass="muted" wrapText="true"/></HBox>
 </VBox>
</AnchorPane>