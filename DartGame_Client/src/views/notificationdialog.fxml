<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.NotificationController" prefWidth="420" prefHeight="220" stylesheets="@theme.css" styleClass="app-root">
 <VBox spacing="16" styleClass="page" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
  <Label text="LỜI MỜI THÁCH ĐẤU" styleClass="eyebrow" wrapText="true"/>
  <Label fx:id="lblMessage" text="Bạn được mời vào một trận đấu!" styleClass="section-title" maxWidth="350" wrapText="true"/>
  <Region VBox.vgrow="ALWAYS"/>
  <HBox alignment="CENTER_RIGHT" spacing="12"><Button text="Để sau" onAction="#handleDecline"/><Button text="Chấp nhận  →" onAction="#handleAccept" styleClass="primary"/></HBox>
 </VBox>
</AnchorPane>