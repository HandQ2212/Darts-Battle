<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:id="rootPane" fx:controller="controllers.RankingController" prefWidth="1100" prefHeight="740" stylesheets="@theme.css" styleClass="app-root">
 <VBox spacing="18" styleClass="page" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
  <HBox alignment="CENTER_LEFT"><Button text="← Sảnh chính" onAction="#handleBack" styleClass="ghost"/><Region HBox.hgrow="ALWAYS"/><Label text="DARTS / BATTLE" styleClass="brand"/></HBox><Region styleClass="divider"/>
  <HBox alignment="CENTER_LEFT" spacing="22"><VBox spacing="7" HBox.hgrow="ALWAYS"><Label text="THÀNH TÍCH" styleClass="eyebrow"/><Label text="Bảng xếp hạng." styleClass="title"/><Label text="Những người chơi dẫn đầu đường đua." styleClass="muted"/></VBox><VBox alignment="CENTER_RIGHT" spacing="6"><Label fx:id="userRankLabel" text="Hạng của bạn: --" styleClass="section-title"/><Label fx:id="userStatsLabel" text="Số trận thắng: --" styleClass="muted"/></VBox><Button text="Làm mới" onAction="#handleRefresh"/></HBox>
  <TableView fx:id="leaderboardTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="rankColumn" text="HẠNG" minWidth="90" maxWidth="120"/><TableColumn fx:id="usernameColumn" text="NGƯỜI CHƠI" minWidth="260"/><TableColumn fx:id="scoreColumn" text="SỐ TRẬN THẮNG" minWidth="140" maxWidth="180"/><TableColumn fx:id="detailsColumn" text="LỊCH SỬ" minWidth="130" maxWidth="180"/></columns><placeholder><Label text="Chưa có người chơi." styleClass="muted"/></placeholder></TableView>
  <HBox fx:id="loadingBox" visible="false" managed="false" alignment="CENTER" spacing="10"><ProgressIndicator prefWidth="20" prefHeight="20"/><Label text="Đang tải bảng xếp hạng..." styleClass="muted"/></HBox>
 </VBox>
</AnchorPane>
